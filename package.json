{
  "name": "@homecore/hc-web-lit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "homeCore web UI \u2014 viewer and designer",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "check": "./tool/check.sh",
    "dev": "vite",
    "ext:build": "vite build --config extensions/vite.config.ts",
    "ext:install": "npm run ext:build && tool/install-extension.sh extensions/hc-button",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "node server/server.ts",
    "start": "npm run build && npm run serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
