# Where core is. One variable points both halves of a development machine at
# the same house: the dev server proxies `/api/v1` here, and hc-web-lit's own
# server asks here who a bearer belongs to.
HC_CORE_URL=http://10.0.10.150:8080

# Where this client's own storage is, in development. In production the same
# origin serves everything, so this is only a dev concern.
HC_CONTENT_URL=http://127.0.0.1:8090

# What hc-web-lit's server keeps, and how large it may get.
#
# Optional, and relative to the **install directory** rather than to wherever
# the process was started — so unpacking this anywhere and starting it from
# anywhere puts a household's content beside it. Set an absolute path to put it
# on a different disk; set a relative one and it stays inside the install,
# which is what makes deploying onto an existing server need no privileges the
# service user does not already have.
HC_CONTENT_DIR=var
HC_PORT=8090
HC_MAX_BYTES=16777216
