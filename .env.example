# Where core is. One variable points both halves of a development machine at
# the same house: the dev server proxies `/api/v1` here, and hc-web-lit's own
# server asks here who a bearer belongs to.
HC_CORE_URL=http://10.0.10.150:8080

# Where this client's own storage is, in development. In production the same
# origin serves everything, so this is only a dev concern.
HC_CONTENT_URL=http://127.0.0.1:8090

# What hc-web-lit's server keeps, and how large it may get. A container mounts
# a volume at this path; a bare install points it wherever the household wants.
HC_CONTENT_DIR=./var
HC_PORT=8090
HC_MAX_BYTES=16777216
