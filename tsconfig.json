{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals"],

    // The specifier an extension author writes (§4.5). It is a real bare
    // import resolved by an import map in the browser, so it has to resolve
    // here too — otherwise `extensions/` typechecks against a path no
    // published extension could ever use.
    "paths": { "@homecore/widget-sdk": ["./src/sdk/index.ts"] },

    // Strict, and then the four `tsc` leaves off even under `strict`. The ABI
    // types are the contract (§13) — a contract with implicit `any` in it is
    // not one.
    // Node runs the server by stripping types, so its imports name `.ts` —
    // which is the one place this project sees them, and the config has to
    // allow it for the test that drives that code.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    // Lit decorators. `useDefineForClassFields: false` is required with
    // experimental decorators — without it, class field initialisers clobber
    // the accessors @property installs, and reactivity silently stops.
    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "server", "extensions", "*.config.ts"]
}
